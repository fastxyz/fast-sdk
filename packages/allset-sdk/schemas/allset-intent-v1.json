{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://allset.fast.xyz/schemas/allset-intent-v1.json",
  "title": "allset/intent/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "chain", "bridge", "transfer_tx", "deadline", "intents"],
  "properties": {
    "schema": { "const": "allset/intent/v1" },
    "kind": { "enum": ["withdraw", "execute", "deposit_back", "revoke", "batch"] },
    "chain": { "type": "string", "pattern": "^eip155:(0|[1-9][0-9]{0,12})$" },
    "bridge": { "$ref": "#/$defs/hex20" },
    "transfer_tx": { "$ref": "#/$defs/hex32" },
    "deadline": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "$comment": "code enforces the unsigned u64 bound"
    },
    "intents": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/intent" } },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "token_symbol", "token_decimals"],
      "properties": {
        "amount": { "$ref": "#/$defs/uint" },
        "token_symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "$comment": "code enforces 16 UTF-8 bytes"
        },
        "token_decimals": { "type": "string", "pattern": "^(0|[1-9][0-9]?)$" }
      }
    }
  },
  "$defs": {
    "uint": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "hex20": { "type": "string", "pattern": "^0x[0-9a-f]{40}$" },
    "hex32": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "hex": { "type": "string", "pattern": "^0x([0-9a-f]{2})*$" },
    "fast": { "type": "string", "pattern": "^fast1[02-9ac-hj-np-z]{58}$" },
    "intent": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "token", "receiver", "value"],
          "properties": {
            "action": { "const": "transfer" },
            "token": { "$ref": "#/$defs/hex20" },
            "receiver": { "$ref": "#/$defs/hex20" },
            "value": { "$ref": "#/$defs/uint" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "target", "calldata", "value"],
          "properties": {
            "action": { "const": "execute" },
            "target": { "$ref": "#/$defs/hex20" },
            "calldata": { "$ref": "#/$defs/hex" },
            "value": { "$ref": "#/$defs/uint" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "token", "fast_receiver", "value"],
          "properties": {
            "action": { "const": "deposit_back" },
            "token": { "$ref": "#/$defs/hex20" },
            "fast_receiver": { "$ref": "#/$defs/fast" },
            "value": { "$ref": "#/$defs/uint" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "value"],
          "properties": {
            "action": { "const": "revoke" },
            "value": { "const": "0" }
          }
        }
      ]
    }
  }
}
